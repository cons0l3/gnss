{
  "commands": [
    {"command":"parameters.add","params":{"name":"outer_cup_x","expression":"54.1 mm"}},
    {"command":"parameters.add","params":{"name":"outer_cup_y","expression":"54.5 mm"}},
    {"command":"parameters.add","params":{"name":"wall_thickness","expression":"2 mm"}},
    {"command":"parameters.add","params":{"name":"cup_height","expression":"15 mm"}},
    {"command":"parameters.add","params":{"name":"corner_radius","expression":"6 mm"}},
    {"command":"parameters.add","params":{"name":"funnel_height","expression":"20 mm"}},
    {"command":"parameters.add","params":{"name":"stem_length","expression":"30 mm"}},
    {"command":"parameters.add","params":{"name":"stem_outer_diameter","expression":"31.5 mm"}},
    {"command":"parameters.add","params":{"name":"stem_bore_diameter","expression":"28.5 mm"}},
    {"command":"parameters.add","params":{"name":"notch_width","expression":"4 mm"}},
    {"command":"parameters.add","params":{"name":"notch_depth","expression":"12.5 mm"}},
    {"command":"parameters.add","params":{"name":"fixing_hole_diameter","expression":"5 mm"}},
    {"command":"parameters.add","params":{"name":"fixing_hole_from_bottom","expression":"10 mm"}},
    {"command":"solid.cylinder","params":{"name":"GPS Holder","body_name":"GPS Holder","radius":"stem_outer_diameter/2","height":"stem_length","base":["0","0","-funnel_height-stem_length"],"operation":"new"}},
    {"command":"sketch.create","params":{"plane":"XY","offset":"-funnel_height","name":"FunnelBaseProfile"}},
    {"command":"sketch.circle.center","params":{"center":[0,0],"radius":15.75}},
    {"command":"sketch.dimension","params":{"entities":["c1"],"type":"diameter","value":"stem_outer_diameter"}},
    {"command":"sketch.finish","params":{}},
    {"command":"sketch.create","params":{"plane":"XY","name":"CupOuterProfile"}},
    {"command":"sketch.rectangle.rounded","params":{"p0":[-27.05,-27.25],"p1":[27.05,27.25],"radius":"corner_radius"}},
    {"command":"sketch.dimension","params":{"entities":["l1"],"value":"outer_cup_x-2*corner_radius"}},
    {"command":"sketch.dimension","params":{"entities":["l4"],"value":"outer_cup_y-2*corner_radius"}},
    {"command":"sketch.dimension","params":{"entities":["origin","l4"],"type":"horizontal","value":"outer_cup_x/2"}},
    {"command":"sketch.dimension","params":{"entities":["origin","l1"],"type":"vertical","value":"outer_cup_y/2"}},
    {"command":"sketch.finish","params":{}},
    {"command":"solid.loft","params":{"name":"Funnel","sections":[{"sketch":"FunnelBaseProfile"},{"sketch":"CupOuterProfile"}],"operation":"join","targets":["GPS Holder"]}},
    {"command":"solid.extrude","params":{"name":"Cup Walls","sketch":"CupOuterProfile","distance":"cup_height","operation":"join","targets":["GPS Holder"]}},
    {"command":"sketch.create","params":{"plane":"XY","offset":"0 mm","name":"CupCavityProfile"}},
    {"command":"sketch.rectangle.rounded","params":{"p0":[-25.05,-25.25],"p1":[25.05,25.25],"radius":"corner_radius-wall_thickness"}},
    {"command":"sketch.dimension","params":{"entities":["l1"],"value":"outer_cup_x-2*corner_radius"}},
    {"command":"sketch.dimension","params":{"entities":["l4"],"value":"outer_cup_y-2*corner_radius"}},
    {"command":"sketch.dimension","params":{"entities":["origin","l4"],"type":"horizontal","value":"outer_cup_x/2-wall_thickness"}},
    {"command":"sketch.dimension","params":{"entities":["origin","l1"],"type":"vertical","value":"outer_cup_y/2-wall_thickness"}},
    {"command":"sketch.finish","params":{}},
    {"command":"solid.extrude","params":{"name":"Cup Cavity","sketch":"CupCavityProfile","distance":"cup_height","operation":"cut","targets":["GPS Holder"]}},
    {"command":"solid.cylinder","params":{"name":"Socket Bore","diameter":"stem_bore_diameter","height":"stem_length","base":["0","0","-funnel_height-stem_length"],"operation":"cut","targets":["GPS Holder"]}},
    {"command":"solid.cylinder","params":{"name":"Cross Fixing Hole","diameter":"fixing_hole_diameter","height":"2*stem_outer_diameter","base":["0","-stem_outer_diameter","-funnel_height-stem_length+fixing_hole_from_bottom"],"axis":"Y","operation":"cut","targets":["GPS Holder"]}},
    {"command":"solid.box","params":{"name":"Rim Notch","length":"notch_width","width":"2*wall_thickness","height":"notch_depth","center":["0","-outer_cup_y/2+wall_thickness/2","cup_height-notch_depth/2"],"operation":"cut","targets":["GPS Holder"]}}
  ]
}